{
  "uid": "rag-step-latency",
  "title": "RAG — step latency",
  "tags": [
    "rag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Per-step / per-phase latency. Quantiles use cumulative histogram buckets so panels always render even with sparse traffic. The 'recent p95' panel uses a rate window and only shows data when queries are actively running.",
  "panels": [
    {
      "id": 1,
      "title": "p50 latency per step",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, step) (rag_step_seconds_bucket))",
          "legendFormat": "{{step}}",
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "p90 latency per step",
