{
  "uid": "rag-retrieval-latency",
  "title": "RAG — retrieval latency",
  "tags": [
    "rag"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Retrieval-phase latency focused on the retrieve (Qdrant hybrid search) and rerank (bge cross-encoder) steps. p50/p90/p99 use cumulative histogram buckets so they always render; the rate-based panels populate only with live traffic.",
  "panels": [
    {
      "id": 1,
      "title": "retrieve — p50 / p90 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "time_series",
          "ref": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rag_step_seconds_bucket{step=\"retrieve\"}))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "time_series",
          "ref": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rag_step_seconds_bucket{step=\"retrieve\"}))",
          "legendFormat": "p90"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "format": "time_series",
          "ref": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rag_step_seconds_bucket{step=\"retrieve\"}))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "title": "retrieve — avg + observation count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "time_series",
          "ref": "A",
          "expr": "rag_step_seconds_sum{step=\"retrieve\"} / rag_step_seconds_count{step=\"retrieve\"}",
          "legendFormat": "avg"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "time_series",
          "ref": "B",
          "expr": "rag_step_seconds_count{step=\"retrieve\"}",
          "legendFormat": "count"
        }
      ]
    },
    {
      "id": 3,
      "title": "rerank — p50 / p90 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
