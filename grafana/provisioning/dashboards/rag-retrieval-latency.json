            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "time_series",
          "ref": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rag_step_seconds_bucket{step=\"rerank\"}))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "time_series",
          "ref": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rag_step_seconds_bucket{step=\"rerank\"}))",
          "legendFormat": "p90"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "format": "time_series",
          "ref": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rag_step_seconds_bucket{step=\"rerank\"}))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "recent retrieve p95 (rate, live traffic only)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "lineStyle": {
              "fill": "solid"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "time_series",
          "ref": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_step_seconds_bucket{step=\"retrieve\"}[$__rate_interval])))",
          "legendFormat": "retrieve p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "time_series",
          "ref": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_step_seconds_bucket{step=\"rerank\"}[$__rate_interval])))",
          "legendFormat": "rerank p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "retrieve vs rerank vs generate — avg comparison",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rag_step_seconds_sum{step=~\"retrieve|rerank|generate\"} / rag_step_seconds_count{step=~\"retrieve|rerank|generate\"}",
          "legendFormat": "{{step}} avg",
          "refId": "A",
          "format": "time_series"
        }
      ]
    }
  ]
}