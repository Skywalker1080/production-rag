{
  "title": "RAG — latency per step",
  "uid": "rag-latency",
  "timezone": "browser",
  "panels": [
    {
      "title": "p95 latency per step",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(rag_step_seconds_bucket[5m])))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "title": "avg latency per step",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (step) (rate(rag_step_seconds_sum[5m])) / sum by (step) (rate(rag_step_seconds_count[5m]))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "title": "requests / errors",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (endpoint, status) (rate(rag_requests_total[5m]))", "legendFormat": "{{endpoint}} {{status}}" },
        { "expr": "sum by (step) (rate(rag_errors_total[5m]))", "legendFormat": "error {{step}}" }
      ]
    },
    {
      "title": "chunks indexed + qdrant up",
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(rag_chunks_indexed_total[5m])", "legendFormat": "chunks/s" },
        { "expr": "rag_qdrant_up", "legendFormat": "qdrant_up" }
      ]
    }
  ]
}
