# --- AWS auth: pick ONE ---
# Option 1 (you have this): Bedrock API key / bearer token
AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrockapi-key-here
AWS_REGION=us-east-1

# Option 2: classic IAM keys (leave empty if using Option 1)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- LLM (Bedrock GLM 5, still API-side) ---
BEDROCK_MODEL_ID=zai.glm-5

# --- Embeddings provider: ollama (local nomic, default) | bedrock (Titan) ---
EMBED_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# (bedrock fallback settings)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_docs

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
EMBED_WORKERS=4
EMBED_BATCH_SIZE=50
EMBED_PACING_SECS=2

# PDF loader: fast (default, seconds) | hi_res (best multi-column, needs poppler+tesseract) | auto
UNSTRUCTURED_STRATEGY=fast

# --- Reranker (bge cross-encoder; GPU if torch+CUDA available) ---
# RERANK=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOPN=30
# RERANK_DEVICE=auto   # auto (cuda if available) | cuda | cpu
# RERANK_BATCH_SIZE=16

# --- Semantic cache (Qdrant, no extra infra) ---
# CACHE_ENABLED=true
# CACHE_COLLECTION=pdf_docs_cache
# CACHE_THRESHOLD=0.92   # cosine similarity; raise to 0.95 if false hits, lower to 0.88 if recall poor
# CACHE_TTL_SECONDS=604800  # 7 days, 0 = no expiry
# CACHE_TOP_K=1

# --- App ---
DATA_DIR=./data

# --- S3 staging for big PDFs (direct-to-S3 multipart) ---
# S3_STAGING_BUCKET=rag-extract-405633560616-use1
# S3_PART_SIZE_MB=16
# S3_UPLOAD_THRESHOLD_MB=50
# S3_PRESIGNED_EXPIRY_SECS=3600
# UPLOAD_DB_PATH=./data/uploads.db

# --- Logging (dedicated file) ---
LOG_DIR=./logs
LOG_FILE=./logs/rag.log
LOG_LEVEL=INFO

# --- HuggingFace (local PDF models cache; optional token vs rate limits) ---
# HF_TOKEN=paste-hf-token-here
